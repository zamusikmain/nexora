POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=local-development-only
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
SEED_DEMO=true
DEMO_PASSWORD=Nexora-Demo-2026!

# Proxies whose X-Forwarded-For is trusted for login throttling (CIDR, IP or hostname, comma-separated).
# Production: add the HTTPS reverse proxy, which must overwrite or append X-Forwarded-For.
TRUSTED_PROXIES=web

# Signed retry keys (B2). Development uses a built-in dev secret; production REQUIRES:
# OPERATION_KEY_SECRET=<random, >= 32 chars, outside Git and database dumps>
# OPERATION_KEY_EPOCH=1   # raise after restoring an older backup to void outstanding keys
# LEGACY_OPERATION_KEYS_UNTIL=2026-12-01T00:00:00Z   # client UUID retries refused from then
# OPERATION_KEY_TTL_DAYS=30

# Optional email copies of notifications (python -m app.notification_dispatch --apply).
# Emails contain no document content, only a link to /notifications. Empty host = email off.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=nexora@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true   # required in production

POSTGRES_PORT=5432

WEB_PORT=3000
API_PORT=8000

# Development bypass is explicit. Production requires clamav.
MALWARE_SCANNER=disabled-development
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Optional role cutover only AFTER provisioning and explicit operator approval.
# Keep three distinct generated secrets outside Git. Do not reuse POSTGRES_PASSWORD.
# compose.roles.yaml expects percent-encoded URL values for these two credentials:
# DB_RUNTIME_PASSWORD_URLENCODED=
# DB_MIGRATIONS_PASSWORD_URLENCODED=
# DB_BACKUP_PASSWORD=
