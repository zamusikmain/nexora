<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_access-management" targetNamespace="https://nexora.example/analysis" exporter="NEXORA code-derived documentation" exporterVersion="1">
  <bpmn:process id="Process_access-management" name="Допуск на конкретную версию" isExecutable="false">
    <bpmn:documentation>AS-IS аналитическая модель; ошибки объединены в бизнес-ветки. Не engine configuration.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_access-management">
      <bpmn:lane id="Lane_access-management_0" name="Requester / owner">
        <bpmn:flowNodeRef>access-management_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_access-management_1" name="API">
        <bpmn:flowNodeRef>access-management_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_restricted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_access-management_2" name="CUSTODIAN">
        <bpmn:flowNodeRef>access-management_cust</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_access-management_3" name="SECURITY">
        <bpmn:flowNodeRef>access-management_sec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_access-management_4" name="Recipient">
        <bpmn:flowNodeRef>access-management_use</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access-management_stop</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="access-management_start" name="Нужен допуск">
      <bpmn:outgoing>Flow_access-management_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="access-management_request" name="Лицо, версия, actions, срок, reason">
      <bpmn:incoming>Flow_access-management_0</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="access-management_validate" name="Зафиксировать и проверить scope">
      <bpmn:incoming>Flow_access-management_1</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="access-management_valid" name="Scope допустим?">
      <bpmn:incoming>Flow_access-management_2</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_access-management_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="access-management_kind" name="Restricted / issuer?">
      <bpmn:incoming>Flow_access-management_4</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_access-management_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="access-management_cust" name="Независимый CUSTODIAN vote">
      <bpmn:incoming>Flow_access-management_6</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="access-management_restricted" name="RESTRICTED?">
      <bpmn:incoming>Flow_access-management_7</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_access-management_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="access-management_sec" name="Другой SECURITY actor vote">
      <bpmn:incoming>Flow_access-management_8</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="access-management_recheck" name="Recheck hash, office, deadline">
      <bpmn:incoming>Flow_access-management_9</bpmn:incoming>
      <bpmn:incoming>Flow_access-management_10</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_access-management_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="access-management_activate" name="ACTIVE, expires от activation">
      <bpmn:incoming>Flow_access-management_5</bpmn:incoming>
      <bpmn:incoming>Flow_access-management_11</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="access-management_use" name="Запросить разрешённый ресурс">
      <bpmn:incoming>Flow_access-management_13</bpmn:incoming>
      <bpmn:outgoing>Flow_access-management_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="access-management_stop" name="Expiry / revoke: доступа нет">
      <bpmn:incoming>Flow_access-management_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="access-management_denied" name="Нет допуска / не подтверждён">
      <bpmn:incoming>Flow_access-management_3</bpmn:incoming>
      <bpmn:incoming>Flow_access-management_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_access-management_0" sourceRef="access-management_start" targetRef="access-management_request" />
    <bpmn:sequenceFlow id="Flow_access-management_1" sourceRef="access-management_request" targetRef="access-management_validate" name="POST request" />
    <bpmn:sequenceFlow id="Flow_access-management_2" sourceRef="access-management_validate" targetRef="access-management_valid" />
    <bpmn:sequenceFlow id="Flow_access-management_3" sourceRef="access-management_valid" targetRef="access-management_denied" name="Нет" />
    <bpmn:sequenceFlow id="Flow_access-management_4" sourceRef="access-management_valid" targetRef="access-management_kind" name="Да" />
    <bpmn:sequenceFlow id="Flow_access-management_5" sourceRef="access-management_kind" targetRef="access-management_activate" name="Owner nonrestricted" />
    <bpmn:sequenceFlow id="Flow_access-management_6" sourceRef="access-management_kind" targetRef="access-management_cust" name="Нужен office vote" />
    <bpmn:sequenceFlow id="Flow_access-management_7" sourceRef="access-management_cust" targetRef="access-management_restricted" />
    <bpmn:sequenceFlow id="Flow_access-management_8" sourceRef="access-management_restricted" targetRef="access-management_sec" name="Да" />
    <bpmn:sequenceFlow id="Flow_access-management_9" sourceRef="access-management_restricted" targetRef="access-management_recheck" name="Нет" />
    <bpmn:sequenceFlow id="Flow_access-management_10" sourceRef="access-management_sec" targetRef="access-management_recheck" />
    <bpmn:sequenceFlow id="Flow_access-management_11" sourceRef="access-management_recheck" targetRef="access-management_activate" name="Два distinct office если restricted" />
    <bpmn:sequenceFlow id="Flow_access-management_12" sourceRef="access-management_recheck" targetRef="access-management_denied" name="Expired / changed / self" />
    <bpmn:sequenceFlow id="Flow_access-management_13" sourceRef="access-management_activate" targetRef="access-management_use" name="ACL на каждом request" />
    <bpmn:sequenceFlow id="Flow_access-management_14" sourceRef="access-management_use" targetRef="access-management_stop" name="Expiry / revoke" />
  </bpmn:process>
