<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_create-document" targetNamespace="https://nexora.example/analysis" exporter="NEXORA code-derived documentation" exporterVersion="1">
  <bpmn:process id="Process_create-document" name="Создание и регистрация" isExecutable="false">
    <bpmn:documentation>AS-IS аналитическая модель; ошибки объединены в бизнес-ветки. Не engine configuration.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_create-document">
      <bpmn:lane id="Lane_create-document_0" name="Инициатор">
        <bpmn:flowNodeRef>create-document_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-document_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-document_success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_create-document_1" name="API">
        <bpmn:flowNodeRef>create-document_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-document_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-document_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create-document_error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="create-document_start" name="Новый документ">
      <bpmn:outgoing>Flow_create-document_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="create-document_input" name="Ввести поля карточки">
      <bpmn:incoming>Flow_create-document_0</bpmn:incoming>
      <bpmn:outgoing>Flow_create-document_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="create-document_check" name="Session, UUID, type и metadata">
      <bpmn:incoming>Flow_create-document_1</bpmn:incoming>
      <bpmn:outgoing>Flow_create-document_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="create-document_valid" name="Проверки успешны?">
      <bpmn:incoming>Flow_create-document_2</bpmn:incoming>
      <bpmn:outgoing>Flow_create-document_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_create-document_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="create-document_save" name="Номер, DRAFT, audit, COMMIT">
      <bpmn:incoming>Flow_create-document_3</bpmn:incoming>
      <bpmn:outgoing>Flow_create-document_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="create-document_success" name="Документ зарегистрирован">
      <bpmn:incoming>Flow_create-document_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="create-document_error" name="Ошибка, регистрации нет">
      <bpmn:incoming>Flow_create-document_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_create-document_0" sourceRef="create-document_start" targetRef="create-document_input" />
    <bpmn:sequenceFlow id="Flow_create-document_1" sourceRef="create-document_input" targetRef="create-document_check" name="POST" />
    <bpmn:sequenceFlow id="Flow_create-document_2" sourceRef="create-document_check" targetRef="create-document_valid" />
    <bpmn:sequenceFlow id="Flow_create-document_3" sourceRef="create-document_valid" targetRef="create-document_save" name="Да / replay" />
    <bpmn:sequenceFlow id="Flow_create-document_4" sourceRef="create-document_valid" targetRef="create-document_error" name="Нет" />
    <bpmn:sequenceFlow id="Flow_create-document_5" sourceRef="create-document_save" targetRef="create-document_success" name="201" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_create-document">
    <bpmndi:BPMNPlane id="Plane_create-document" bpmnElement="Process_create-document">
      <bpmndi:BPMNShape id="LaneShape_create-document_0" bpmnElement="Lane_create-document_0" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1650" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneShape_create-document_1" bpmnElement="Lane_create-document_1" isHorizontal="true">
        <dc:Bounds x="20" y="220" width="1650" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_start" bpmnElement="create-document_start">
        <dc:Bounds x="70" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="35" y="134" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_input" bpmnElement="create-document_input">
        <dc:Bounds x="180" y="80" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_check" bpmnElement="create-document_check">
        <dc:Bounds x="370" y="280" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_valid" bpmnElement="create-document_valid">
        <dc:Bounds x="550" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="348" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_save" bpmnElement="create-document_save">
        <dc:Bounds x="720" y="280" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_success" bpmnElement="create-document_success">
        <dc:Bounds x="950" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="915" y="134" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_create-document_error" bpmnElement="create-document_error">
        <dc:Bounds x="720" y="355" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="399" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_create-document_0" bpmnElement="Flow_create-document_0">
        <di:waypoint x="106" y="108.0" />
        <di:waypoint x="143.0" y="108.0" />
        <di:waypoint x="143.0" y="115.0" />
        <di:waypoint x="180" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_create-document_1" bpmnElement="Flow_create-document_1">
        <di:waypoint x="310" y="115.0" />
        <di:waypoint x="340.0" y="115.0" />
        <di:waypoint x="340.0" y="315.0" />
        <di:waypoint x="370" y="315.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="295.0" y="280.0" width="90" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_create-document_2" bpmnElement="Flow_create-document_2">
        <di:waypoint x="500" y="315.0" />
        <di:waypoint x="525.0" y="315.0" />
        <di:waypoint x="525.0" y="315.0" />
        <di:waypoint x="550" y="315.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_create-document_3" bpmnElement="Flow_create-document_3">
        <di:waypoint x="600" y="315.0" />
        <di:waypoint x="660.0" y="315.0" />
        <di:waypoint x="660.0" y="315.0" />
        <di:waypoint x="720" y="315.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615.0" y="280.0" width="90" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_create-document_4" bpmnElement="Flow_create-document_4">
        <di:waypoint x="600" y="315.0" />
        <di:waypoint x="660.0" y="315.0" />
        <di:waypoint x="660.0" y="373.0" />
        <di:waypoint x="720" y="373.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615.0" y="338.0" width="90" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_create-document_5" bpmnElement="Flow_create-document_5">
        <di:waypoint x="850" y="315.0" />
        <di:waypoint x="900.0" y="315.0" />
        <di:waypoint x="900.0" y="108.0" />
        <di:waypoint x="950" y="108.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="855.0" y="73.0" width="90" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>