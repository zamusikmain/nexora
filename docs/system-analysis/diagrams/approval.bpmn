<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_approval" targetNamespace="https://nexora.example/analysis" exporter="NEXORA code-derived documentation" exporterVersion="1">
  <bpmn:process id="Process_approval" name="Согласование закреплённой версии" isExecutable="false">
    <bpmn:documentation>AS-IS аналитическая модель; ошибки объединены в бизнес-ветки. Не engine configuration.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_approval">
      <bpmn:lane id="Lane_approval_0" name="Владелец">
        <bpmn:flowNodeRef>approval_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_approval_1" name="API">
        <bpmn:flowNodeRef>approval_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_pin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_all</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_error</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_approval_2" name="Текущие согласующие">
        <bpmn:flowNodeRef>approval_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approval_terminal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="approval_start" name="Документ с файлом">
      <bpmn:outgoing>Flow_approval_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="approval_send" name="Выбрать маршрут и запустить">
      <bpmn:incoming>Flow_approval_0</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="approval_validate" name="Проверить owner, revision, scan, route">
      <bpmn:incoming>Flow_approval_1</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="approval_valid" name="Разрешён start?">
      <bpmn:incoming>Flow_approval_2</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_approval_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="approval_pin" name="Snapshot и план; current PENDING">
      <bpmn:incoming>Flow_approval_3</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="approval_decision" name="Проверить pinned version и решить">
      <bpmn:incoming>Flow_approval_5</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_6</bpmn:outgoing>
      <bpmn:incoming>Flow_approval_11</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_choice" name="Решение?">
      <bpmn:incoming>Flow_approval_6</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_approval_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="approval_all" name="Все этапы согласованы?">
      <bpmn:incoming>Flow_approval_7</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_approval_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="approval_next" name="Ждать остальных / открыть этап">
      <bpmn:incoming>Flow_approval_10</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="approval_approved" name="APPROVED, revoke grants">
      <bpmn:incoming>Flow_approval_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="approval_terminal" name="REJECTED / REVISION_REQUIRED">
      <bpmn:incoming>Flow_approval_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="approval_error" name="Ошибка, процесс не начат">
      <bpmn:incoming>Flow_approval_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_approval_0" sourceRef="approval_start" targetRef="approval_send" />
    <bpmn:sequenceFlow id="Flow_approval_1" sourceRef="approval_send" targetRef="approval_validate" name="POST workflows" />
    <bpmn:sequenceFlow id="Flow_approval_2" sourceRef="approval_validate" targetRef="approval_valid" />
    <bpmn:sequenceFlow id="Flow_approval_3" sourceRef="approval_valid" targetRef="approval_pin" name="Да" />
    <bpmn:sequenceFlow id="Flow_approval_4" sourceRef="approval_valid" targetRef="approval_error" name="Нет" />
    <bpmn:sequenceFlow id="Flow_approval_5" sourceRef="approval_pin" targetRef="approval_decision" />
    <bpmn:sequenceFlow id="Flow_approval_6" sourceRef="approval_decision" targetRef="approval_choice" name="POST decisions" />
    <bpmn:sequenceFlow id="Flow_approval_7" sourceRef="approval_choice" targetRef="approval_all" name="approve" />
    <bpmn:sequenceFlow id="Flow_approval_8" sourceRef="approval_choice" targetRef="approval_terminal" name="reject / revision" />
    <bpmn:sequenceFlow id="Flow_approval_9" sourceRef="approval_all" targetRef="approval_approved" name="Да" />
    <bpmn:sequenceFlow id="Flow_approval_10" sourceRef="approval_all" targetRef="approval_next" name="Нет" />
    <bpmn:sequenceFlow id="Flow_approval_11" sourceRef="approval_next" targetRef="approval_decision" name="Текущий PENDING" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_approval">
    <bpmndi:BPMNPlane id="Plane_approval" bpmnElement="Process_approval">
      <bpmndi:BPMNShape id="LaneShape_approval_0" bpmnElement="Lane_approval_0" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="1650" height="200" />
