<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_rejection-resubmit" targetNamespace="https://nexora.example/analysis" exporter="NEXORA code-derived documentation" exporterVersion="1">
  <bpmn:process id="Process_rejection-resubmit" name="Отклонение или возврат и новая итерация" isExecutable="false">
    <bpmn:documentation>AS-IS аналитическая модель; ошибки объединены в бизнес-ветки. Не engine configuration.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_rejection-resubmit">
      <bpmn:lane id="Lane_rejection-resubmit_0" name="Согласующий">
        <bpmn:flowNodeRef>rejection-resubmit_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_act</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rejection-resubmit_1" name="API">
        <bpmn:flowNodeRef>rejection-resubmit_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_resubmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_error</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rejection-resubmit_2" name="Владелец">
        <bpmn:flowNodeRef>rejection-resubmit_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejection-resubmit_again</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="rejection-resubmit_start" name="Текущая проверка">
      <bpmn:outgoing>Flow_rejection-resubmit_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="rejection-resubmit_act" name="Выбрать reject/revision, комментарий">
      <bpmn:incoming>Flow_rejection-resubmit_0</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="rejection-resubmit_validate" name="Проверить current assignment и scope">
      <bpmn:incoming>Flow_rejection-resubmit_1</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="rejection-resubmit_valid" name="Допустимо?">
      <bpmn:incoming>Flow_rejection-resubmit_2</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejection-resubmit_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="rejection-resubmit_outcome" name="Какой исход?">
      <bpmn:incoming>Flow_rejection-resubmit_3</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejection-resubmit_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="rejection-resubmit_rejected" name="REJECTED; direct resubmit нет">
      <bpmn:incoming>Flow_rejection-resubmit_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="rejection-resubmit_returned" name="REVISION_REQUIRED; receipt, revoke">
      <bpmn:incoming>Flow_rejection-resubmit_6</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="rejection-resubmit_edit" name="Править; новая версия; новый UUID">
      <bpmn:incoming>Flow_rejection-resubmit_7</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="rejection-resubmit_resubmit" name="Проверить CAS, файл, новый маршрут">
      <bpmn:incoming>Flow_rejection-resubmit_8</bpmn:incoming>
      <bpmn:outgoing>Flow_rejection-resubmit_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejection-resubmit_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="rejection-resubmit_again" name="Новый workflow IN_APPROVAL">
      <bpmn:incoming>Flow_rejection-resubmit_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="rejection-resubmit_error" name="Ошибка: переход не выполнен">
      <bpmn:incoming>Flow_rejection-resubmit_4</bpmn:incoming>
      <bpmn:incoming>Flow_rejection-resubmit_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_0" sourceRef="rejection-resubmit_start" targetRef="rejection-resubmit_act" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_1" sourceRef="rejection-resubmit_act" targetRef="rejection-resubmit_validate" name="POST decisions" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_2" sourceRef="rejection-resubmit_validate" targetRef="rejection-resubmit_valid" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_3" sourceRef="rejection-resubmit_valid" targetRef="rejection-resubmit_outcome" name="Да" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_4" sourceRef="rejection-resubmit_valid" targetRef="rejection-resubmit_error" name="Нет" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_5" sourceRef="rejection-resubmit_outcome" targetRef="rejection-resubmit_rejected" name="reject" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_6" sourceRef="rejection-resubmit_outcome" targetRef="rejection-resubmit_returned" name="revision" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_7" sourceRef="rejection-resubmit_returned" targetRef="rejection-resubmit_edit" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_8" sourceRef="rejection-resubmit_edit" targetRef="rejection-resubmit_resubmit" name="POST workflows" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_9" sourceRef="rejection-resubmit_resubmit" targetRef="rejection-resubmit_again" name="Успех" />
    <bpmn:sequenceFlow id="Flow_rejection-resubmit_10" sourceRef="rejection-resubmit_resubmit" targetRef="rejection-resubmit_error" name="CAS / scan / route" />
  </bpmn:process>
